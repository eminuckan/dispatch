# Dispatch has no product account/login requirement. Direct pairing, LAN,
# Tailscale, and SSH use the environment's own authentication. An optional
# Dispatch Connect account adds discovery and managed remote-access convenience.
#
# Public Dispatch Connect origin. The build loader also exposes this as
# VITE_DISPATCH_CONNECT_URL / EXPO_PUBLIC_DISPATCH_CONNECT_URL.
# DISPATCH_CONNECT_URL=https://connect.example.com
#
# The Clerk/relay values are retained only for the optional legacy T3 Connect
# transport while its account-based relay principal is replaced. They are
# disabled by default. Copy this file to .env only for services you operate.
# Do not add server-side secrets to this file.

# DISPATCH_CLERK_PUBLISHABLE_KEY=pk_test_...
# DISPATCH_CLERK_JWT_TEMPLATE=dispatch-relay
# DISPATCH_CLERK_CLI_OAUTH_CLIENT_ID=...
# DISPATCH_CLERK_PASSKEY_RP_DOMAINS=clerk.example.com

# Optional self-hosted relay / hosted app.
# DISPATCH_RELAY_URL=https://relay.example.com
# DISPATCH_HOSTED_APP_URL=https://app.example.com

# Optional signed Apple builds.
# DISPATCH_APPLE_TEAM_ID=ABC1234567
# DISPATCH_MACOS_PROVISIONING_PROFILE=/absolute/path/to/dispatch.provisionprofile
# DISPATCH_IOS_PERSONAL_TEAM=1
# DISPATCH_IOS_PERSONAL_TEAM_BUNDLE_ID=com.example.dispatch

# Optional Expo/EAS mobile distribution.
# DISPATCH_EXPO_OWNER=your-expo-owner
# DISPATCH_EXPO_PROJECT_ID=00000000-0000-0000-0000-000000000000
# DISPATCH_MOBILE_UPDATES_URL=https://u.expo.dev/00000000-0000-0000-0000-000000000000
# DISPATCH_MOBILE_UPDATES_ENABLED=1

# Public, ingest-only mobile OpenTelemetry configuration.
# DISPATCH_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# DISPATCH_MOBILE_OTLP_TRACES_DATASET=dispatch-mobile-traces-dev
# DISPATCH_MOBILE_OTLP_TRACES_TOKEN=xaat-...

# Legacy T3CODE_* names are still accepted for compatibility, but new Dispatch
# configuration should use DISPATCH_*.

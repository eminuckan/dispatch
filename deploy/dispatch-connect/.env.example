# Public HTTPS origin routed by Dokploy to the `connect` service on port 8787.
DISPATCH_CONNECT_PUBLIC_URL=https://connect.example.com

# Generate independent high-entropy values, for example with:
#   openssl rand -base64 48
POSTGRES_PASSWORD=replace-me
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-bytes
CONNECT_CREDENTIAL_SECRET=replace-me-with-a-different-random-secret

# Comma-separated browser/native origins that may call Dispatch Connect.
# Electron sends the full dispatch://app origin; bare schemes alone only cover native callbacks.
# Add production web origins when they are enabled.
CONNECT_ALLOWED_ORIGINS=https://app.example.com,http://127.0.0.1:*,http://localhost:*,https://*.ts.net,https://*.remote.example.com,dispatch://app,dispatch-dev://app,dispatch://,dispatch-dev://

# Optional. Default is 10 minutes.
CONNECT_PAIRING_TTL_SECONDS=600

# Optional override. Connect already serves a same-origin /device approval page.
# CONNECT_DEVICE_VERIFICATION_URL=https://app.example.com/device

# Optional managed Cloudflare Tunnel fallback. Set all four together. The
# account/zone/domain are operator-owned; Dispatch users never need Cloudflare
# credentials. The domain/zone must already exist.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CONNECT_TUNNEL_DOMAIN=remote.example.com

# Optional hosted Smart Routing. Set the operator's key only in Dokploy's secret
# environment; never bake it into desktop/web assets or ask users to supply it.
# CONNECT_JEV_API_KEY=
CONNECT_SMART_ROUTING_ENABLED=true
CONNECT_ROUTING_MONTHLY_BUDGET_USD=25
CONNECT_ROUTING_DAILY_BUDGET_USD=2
CONNECT_ROUTING_ACCOUNT_MONTHLY_REQUESTS=10000
CONNECT_ROUTING_ACCOUNT_DAILY_REQUESTS=1000
CONNECT_ROUTING_NEW_ACCOUNT_DAILY_REQUESTS=100
CONNECT_ROUTING_ACCOUNT_BURST_REQUESTS=16
CONNECT_ROUTING_ACCOUNT_MINUTE_REQUESTS=30
CONNECT_ROUTING_ACCOUNT_HOURLY_REQUESTS=300
CONNECT_ROUTING_ENVIRONMENT_MINUTE_REQUESTS=20
CONNECT_ROUTING_ACCOUNT_ENVIRONMENTS=20
CONNECT_ROUTING_IP_MINUTE_REQUESTS=120
CONNECT_ROUTING_IP_DAILY_REQUESTS=5000
CONNECT_ROUTING_ACCOUNT_CONCURRENCY=2
CONNECT_ROUTING_GLOBAL_CONCURRENCY=32

# Only the actual directly connecting reverse proxy CIDR(s). Never trust all IPs.
# The proxy must overwrite/append X-Forwarded-For, and origin access must be
# restricted to it. An unset value safely groups traffic by the socket address.
# CONNECT_TRUSTED_PROXY_CIDRS=172.20.0.2/32

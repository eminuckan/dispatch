# Public HTTPS origin routed by Dokploy to the `connect` service on port 8787.
DISPATCH_CONNECT_PUBLIC_URL=https://connect.example.com

# Generate independent high-entropy values, for example with:
#   openssl rand -base64 48
POSTGRES_PASSWORD=replace-me
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-bytes
CONNECT_CREDENTIAL_SECRET=replace-me-with-a-different-random-secret

# Comma-separated browser/native origins that may call Dispatch Connect.
# Add production web origins and Dispatch app schemes when they are enabled.
CONNECT_ALLOWED_ORIGINS=https://app.example.com,http://127.0.0.1:*,http://localhost:*,https://*.ts.net,https://*.remote.example.com,dispatch://,dispatch-dev://

# Optional. Default is 10 minutes.
CONNECT_PAIRING_TTL_SECONDS=600

# Optional override. Connect already serves a same-origin /device approval page.
# CONNECT_DEVICE_VERIFICATION_URL=https://app.example.com/device

# Optional managed Cloudflare Tunnel fallback. Set all four together. The
# account/zone/domain are operator-owned; Dispatch users never need Cloudflare
# credentials. The domain/zone must already exist.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CONNECT_TUNNEL_DOMAIN=remote.example.com

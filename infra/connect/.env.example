DATABASE_URL=postgres://dispatch:change-me@postgres:5432/dispatch_connect
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=https://connect.example.com
CONNECT_CREDENTIAL_SECRET=replace-with-a-different-at-least-32-random-byte-secret
HOST=0.0.0.0
PORT=8787
CONNECT_PAIRING_TTL_SECONDS=600
# Comma-separated. Wildcards are supported for variable Dispatch web origins.
CONNECT_ALLOWED_ORIGINS=https://app.example.com,http://127.0.0.1:*,http://localhost:*,https://*.ts.net,https://*.remote.example.com

# Optional override. By default Connect serves its own approval UI at BETTER_AUTH_URL/device.
# CONNECT_DEVICE_VERIFICATION_URL=https://app.example.com/device

# Optional managed Cloudflare Tunnel. Set all four together; the zone/domain must already exist.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CONNECT_TUNNEL_DOMAIN=remote.example.com
# Hosted Smart Routing (operator secrets, not client configuration).
# CONNECT_JEV_API_KEY=
CONNECT_SMART_ROUTING_ENABLED=true
CONNECT_ROUTING_MONTHLY_BUDGET_USD=25
CONNECT_ROUTING_DAILY_BUDGET_USD=2
CONNECT_ROUTING_ACCOUNT_MONTHLY_REQUESTS=10000
CONNECT_ROUTING_ACCOUNT_DAILY_REQUESTS=1000
CONNECT_ROUTING_NEW_ACCOUNT_DAILY_REQUESTS=100
CONNECT_ROUTING_ACCOUNT_BURST_REQUESTS=6
CONNECT_ROUTING_ACCOUNT_MINUTE_REQUESTS=30
CONNECT_ROUTING_ACCOUNT_HOURLY_REQUESTS=300
CONNECT_ROUTING_ENVIRONMENT_MINUTE_REQUESTS=20
CONNECT_ROUTING_ACCOUNT_ENVIRONMENTS=20
CONNECT_ROUTING_IP_MINUTE_REQUESTS=120
CONNECT_ROUTING_IP_DAILY_REQUESTS=5000
CONNECT_ROUTING_ACCOUNT_CONCURRENCY=2
CONNECT_ROUTING_GLOBAL_CONCURRENCY=32
# CONNECT_TRUSTED_PROXY_CIDRS=
